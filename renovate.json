{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>tx-pts-dai/renovate-config"
  ],
  "schedule": [
    "after 9am on Monday"
  ],
  "automergeStrategy": "squash",
  "enabledManagers": [
    "custom.regex"
  ],
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Upstream release whose CRDs .github/workflows/crd-regenerate.yaml converts into schemas",
      "managerFilePatterns": ["/^\\.github/crd-sources\\.yaml$/"],
      "matchStrings": [
        "- repo: (?<depName>\\S+)\\n\\s+version: (?<currentValue>\\S+)\\n"
      ],
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "One PR per upstream project, regenerated by crd-regenerate.yaml",
      "matchFileNames": [".github/crd-sources.yaml"],
      "addLabels": ["crd-schemas"],
      "commitMessageTopic": "{{depName}} CRD schemas"
    }
  ]
}
